{
  "manifest_version": 3,
  "name": "Langchanger",
  "version": "1.0",
  "description": "Change webpage language into different languages",
  "permissions": ["scripting", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}